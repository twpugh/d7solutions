# Cloudflare Pages response headers (copied to site/_headers by build.py).
# NOTE: when several rules match one URL, Pages COMBINES same-named headers
# rather than overriding, so the cache rules below are deliberately disjoint.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'

# stylesheet: short cache (its URL carries a content hash anyway)
/assets/site.css
  Cache-Control: public, max-age=3600

# images and logos: long cache
/assets/img/*
  Cache-Control: public, max-age=2592000

/assets/logos/*
  Cache-Control: public, max-age=2592000

/assets/favicon.svg
  Cache-Control: public, max-age=2592000
